# 服务监听地址。容器内建议保持 :4030。
LISTEN_ADDR=:4030

# 数据库：sqlite 或 mariadb。postgres 仅预留，不可用。
DB_DRIVER=sqlite
SQLITE_PATH=/app/config/app.db

# MariaDB 示例。使用 MariaDB 时设置 DB_DRIVER=mariadb 并填写本项。
# 注意：这里不要填写上游绘图 API Key。
MARIADB_DSN=

# 上游完整生图 endpoint。
# 可以留空，然后在 WebUI 的“基础设置”里填写。
# 如果这里填写，服务首次初始化数据库时会写入 settings，之后也可以在 WebUI 修改。
UPSTREAM_ENDPOINT=

# 图片保存目录。Docker 环境推荐 /app/images，并通过 volume 挂载到宿主机。
IMAGE_DIR=/app/images

# 上游模型能力目录文件。Docker 默认随 /app/config 挂载持久化。
MODEL_CATALOG_PATH=/app/config/upstream_models.json

# 对外访问图片时使用的站点前缀。
# 例如：http://你的内网IP:4030
# 留空时返回 /images/... 相对路径。
PUBLIC_BASE_URL=

# WebUI session 有效期，单位小时。
SESSION_TTL_HOURS=24

# 默认上游请求超时，单位秒。WebUI 中也可以配置实际请求超时。
DEFAULT_TIMEOUT_SECONDS=120
