# 服务监听地址。容器内建议保持 :4030。
LISTEN_ADDR=:4030

# 数据库：sqlite 或 mariadb。postgres 仅预留，不可用。
DB_DRIVER=sqlite
SQLITE_PATH=/app/config/app.db

# MariaDB 示例。使用 MariaDB 时设置 DB_DRIVER=mariadb 并填写本项。
# 注意：这里不要填写上游绘图 API Key。
MARIADB_DSN=

# 上游完整生图 endpoint。
# 可以留空，然后在 WebUI 的“基础设置”里填写。
# 如果这里填写，服务首次初始化数据库时会写入 settings，之后也可以在 WebUI 修改。
UPSTREAM_ENDPOINT=

# 图片保存目录。Docker 环境推荐 /app/images，并通过 volume 挂载到宿主机。
IMAGE_DIR=/app/images

# 上游模型能力目录文件。此处是 Docker 容器内默认路径，随 ./config:/app/config 挂载持久化。
# 源码直接运行且不设置本变量时，默认使用 config/upstream_models.json。
MODEL_CATALOG_PATH=/app/config/upstream_models.json

# 对外访问图片时使用的站点前缀，必填。
# 必须是下游可访问的 http(s) 绝对地址，可带 path，例如：https://example.com/nimbus
# 生成图片默认会以 PUBLIC_BASE_URL + /images/... 的绝对 URL 返回给下游。
PUBLIC_BASE_URL=http://你的内网IP:4030

# 图片返回模式：local_url 默认返回本地归档 URL；upstream_url 兼容旧行为，返回上游原图 URL。
# 可选值：local_url / upstream_url
IMAGE_RETURN_MODE=local_url

# WebUI session 有效期，单位小时。
SESSION_TTL_HOURS=24

# 默认上游请求超时，单位秒。WebUI 中也可以配置实际请求超时。
DEFAULT_TIMEOUT_SECONDS=120
